<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cuestionario R - Estructuras, Gráficos, AED y Programación</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a472a, #2d6a4f, #40916c);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            max-width: 850px;
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border-radius: 25px;
            padding: 35px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        h1 {
            text-align: center;
            color: #f0f0f0;
            margin-bottom: 8px;
            font-size: 1.8em;
            letter-spacing: 1px;
        }

        .subtitulo {
            text-align: center;
            color: #a8e6cf;
            margin-bottom: 30px;
            font-size: 0.95em;
            font-weight: 300;
        }

        .progreso {
            text-align: center;
            margin-bottom: 15px;
            font-size: 1.05em;
            color: #c8e6df;
            font-weight: 500;
        }

        .barra-progreso {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            margin-bottom: 30px;
            overflow: hidden;
        }

        .barra-progreso-interna {
            height: 100%;
            background: linear-gradient(90deg, #52b788, #1b4332);
            border-radius: 3px;
            transition: width 0.5s ease;
        }

        .pregunta-container {
            display: none;
            animation: fadeSlideIn 0.45s ease;
        }

        .pregunta-container.activa {
            display: block;
        }

        @keyframes fadeSlideIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .numero-pregunta {
            color: #52b788;
            font-weight: 700;
            font-size: 1em;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .texto-pregunta {
            background: rgba(82, 183, 136, 0.08);
            border-left: 5px solid #52b788;
            padding: 18px 22px;
            border-radius: 10px;
            margin-bottom: 25px;
            font-size: 1.12em;
            line-height: 1.6;
            color: #e8f0ec;
        }

        .opciones {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .opcion {
            background: rgba(255, 255, 255, 0.04);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 14px 18px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 14px;
            color: #d0e8df;
        }

        .opcion:hover {
            background: rgba(82, 183, 136, 0.12);
            border-color: rgba(82, 183, 136, 0.5);
            transform: translateX(6px);
        }

        .opcion.seleccionada {
            background: rgba(82, 183, 136, 0.2);
            border-color: #52b788;
            box-shadow: 0 0 18px rgba(82, 183, 136, 0.25);
        }

        .opcion.correcta {
            background: rgba(46, 204, 113, 0.25) !important;
            border-color: #2ecc71 !important;
            box-shadow: 0 0 18px rgba(46, 204, 113, 0.2) !important;
        }

        .opcion.incorrecta {
            background: rgba(231, 76, 60, 0.25) !important;
            border-color: #e74c3c !important;
            box-shadow: 0 0 18px rgba(231, 76, 60, 0.2) !important;
        }

        .letra-opcion {
            background: rgba(82, 183, 136, 0.25);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1em;
            flex-shrink: 0;
            color: #b8e0cc;
        }

        .texto-opcion {
            flex: 1;
            font-size: 1.02em;
        }

        .explicacion {
            display: none;
            margin-top: 20px;
            padding: 16px 20px;
            background: rgba(255, 215, 0, 0.08);
            border-left: 4px solid #ffd700;
            border-radius: 8px;
            line-height: 1.6;
            color: #e8e0b0;
        }

        .explicacion.visible {
            display: block;
            animation: fadeSlideIn 0.35s ease;
        }

        .botones {
            display: flex;
            justify-content: space-between;
            margin-top: 35px;
            flex-wrap: wrap;
            gap: 10px;
        }

        button {
            padding: 12px 25px;
            border: none;
            border-radius: 25px;
            font-size: 0.95em;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .btn-anterior {
            background: rgba(255, 255, 255, 0.06);
            color: #d0e8df;
            border: 2px solid rgba(255, 255, 255, 0.15);
        }

        .btn-anterior:hover {
            background: rgba(255, 255, 255, 0.12);
        }

        .btn-siguiente {
            background: linear-gradient(135deg, #2d6a4f, #1b4332);
            color: white;
        }

        .btn-siguiente:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(45, 106, 79, 0.5);
        }

        .btn-reiniciar {
            background: transparent;
            color: #ffd700;
            border: 2px solid #ffd700;
        }

        .btn-reiniciar:hover {
            background: rgba(255, 215, 0, 0.08);
        }

        .resultado-container {
            display: none;
            text-align: center;
            padding: 25px;
        }

        .resultado-container.visible {
            display: block;
            animation: fadeSlideIn 0.55s ease;
        }

        .puntaje {
            font-size: 4.5em;
            font-weight: 700;
            color: #ffd700;
            margin: 25px 0;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
        }

        .mensaje-final {
            font-size: 1.2em;
            margin-bottom: 30px;
            line-height: 1.7;
            color: #d0e8df;
        }

        button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            pointer-events: none;
        }

        @media (max-width: 600px) {
            .container {
                padding: 22px 15px;
                border-radius: 18px;
            }
            h1 {
                font-size: 1.35em;
            }
            .texto-pregunta {
                font-size: 1em;
                padding: 14px 16px;
            }
            button {
                padding: 10px 16px;
                font-size: 0.88em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>📊 Cuestionario de R</h1>
        <p class="subtitulo">Estructuras de Datos · Gráficos · AED · Programación (bucles y apply)</p>

        <div id="zona-cuestionario">
            <div class="progreso" id="texto-progreso">Pregunta 1 de 12</div>
            <div class="barra-progreso">
                <div class="barra-progreso-interna" id="barra-progreso" style="width: 8.33%;"></div>
            </div>
            <div id="contenedor-preguntas"></div>
            <div class="botones" id="botones-navegacion">
                <button class="btn-anterior" id="btn-anterior" onclick="preguntaAnterior()">◀ Anterior</button>
                <button class="btn-reiniciar" onclick="reiniciarCuestionario()">🔄 Reiniciar</button>
                <button class="btn-siguiente" id="btn-siguiente" onclick="preguntaSiguiente()">Siguiente ▶</button>
            </div>
        </div>

        <div class="resultado-container" id="resultado-container">
            <h2 style="color: #f0f0f0;">🎉 ¡Cuestionario Completado!</h2>
            <div class="puntaje" id="puntaje-final">0/12</div>
            <p class="mensaje-final" id="mensaje-final"></p>
            <button class="btn-reiniciar" onclick="reiniciarCuestionario()">🔄 Volver a Intentar</button>
        </div>
    </div>

    <script>
        const preguntas = [
            {
                "id": 1,
                "pregunta": "¿Cuál de las siguientes afirmaciones sobre los paquetes (librerías) en R es CORRECTA?",
                "opciones": {
                    "a": "Los paquetes se instalan una sola vez con install.packages() y se cargan cada sesión con library()",
                    "b": "Los paquetes se instalan cada sesión con library() y se cargan una sola vez con install.packages()",
                    "c": "El paquete base contiene todos los paquetes disponibles en CRAN",
                    "d": "Para usar una función de un paquete sin cargarlo, se usa paquete$funcion()"
                },
                "respuesta_correcta": "a",
                "explicacion": "install.packages() instala el paquete (una sola vez), library() lo carga en memoria (cada sesión). Para usar una función sin cargar el paquete se usa paquete::funcion(), no $."
            },
            {
                "id": 2,
                "pregunta": "¿Qué función se utiliza para obtener la lista de objetos en memoria en R?",
                "opciones": {
                    "a": "objects()",
                    "b": "list()",
                    "c": "ls()",
                    "d": "dir()"
                },
                "respuesta_correcta": "c",
                "explicacion": "La función ls() devuelve un vector con los nombres de todos los objetos en el área de trabajo actual. rm() elimina objetos, y rm(list = ls()) borra todo."
            },
            {
                "id": 3,
                "pregunta": "¿Cuál de las siguientes estructuras de datos en R permite almacenar columnas de diferentes tipos (numérico, carácter, factor) en un mismo objeto?",
                "opciones": {
                    "a": "Matriz",
                    "b": "Vector",
                    "c": "Lista",
                    "d": "Data frame"
                },
                "respuesta_correcta": "d",
                "explicacion": "El data.frame es la estructura más habitual para conjuntos de datos. A diferencia de las matrices y vectores (que requieren un solo tipo), cada columna de un data.frame puede ser de un tipo diferente."
            },
            {
                "id": 4,
                "pregunta": "¿Qué parámetro de la función plot() se utiliza para cambiar el tipo de punto (símbolo) en un gráfico de dispersión?",
                "opciones": {
                    "a": "col",
                    "b": "lty",
                    "c": "pch",
                    "d": "cex"
                },
                "respuesta_correcta": "c",
                "explicacion": "pch (plotting character) define el tipo de símbolo: 1 = círculo, 2 = triángulo, 3 = cruz, 16 = círculo sólido, etc. lty es para tipo de línea, col para color, cex para tamaño."
            },
            {
                "id": 5,
                "pregunta": "¿Cómo se guarda un gráfico de R en un archivo PDF mediante código?",
                "opciones": {
                    "a": "savePlot('grafico.pdf')",
                    "b": "pdf('grafico.pdf'); plot(cars); dev.off()",
                    "c": "export('grafico.pdf', plot(cars))",
                    "d": "print(plot(cars), file='grafico.pdf')"
                },
                "respuesta_correcta": "b",
                "explicacion": "Primero se abre el dispositivo gráfico con pdf('archivo.pdf'), luego se genera el gráfico y finalmente se cierra el dispositivo con dev.off(). Sin dev.off() el archivo puede quedar corrupto."
            },
            {
                "id": 6,
                "pregunta": "¿Qué función de R se utiliza para leer un archivo CSV donde el separador de columnas es ';' y el decimal es ','?",
                "opciones": {
                    "a": "read.csv()",
                    "b": "read.table(sep=';', dec='.')",
                    "c": "read.csv2()",
                    "d": "read.delim()"
                },
                "respuesta_correcta": "c",
                "explicacion": "read.csv2() es una adaptación de read.table() con sep=';' y dec=',' (formato común en español). read.csv() usa sep=',' y dec='.' (formato inglés)."
            },
            {
                "id": 7,
                "pregunta": "¿Cuál de las siguientes medidas de centralización es ROBUSTA (menos sensible a valores atípicos)?",
                "opciones": {
                    "a": "Media aritmética",
                    "b": "Varianza",
                    "c": "Mediana",
                    "d": "Rango intercuartílico"
                },
                "respuesta_correcta": "c",
                "explicacion": "La mediana es robusta porque solo depende del orden de los datos, no de sus valores exactos. La media es muy sensible a valores atípicos. El rango intercuartílico es una medida de dispersión robusta, no de centralización."
            },
            {
                "id": 8,
                "pregunta": "¿Qué gráfico es más adecuado para comparar la distribución de una variable numérica entre varios grupos (ej. salario por categoría laboral)?",
                "opciones": {
                    "a": "Diagrama de barras",
                    "b": "Gráfico de sectores (pie)",
                    "c": "Diagrama de caja (boxplot)",
                    "d": "Histograma"
                },
                "respuesta_correcta": "c",
                "explicacion": "El boxplot muestra mediana, cuartiles, rango y valores atípicos, permitiendo comparar distribuciones de forma compacta. El histograma es útil para una sola variable, los gráficos de barras/sectores son para variables cualitativas."
            },
            {
                "id": 9,
                "pregunta": "¿Cuál es la sintaxis CORRECTA de un bucle 'for' en R?",
                "opciones": {
                    "a": "for i in 1:10 { print(i) }",
                    "b": "for (i in 1:10) { print(i) }",
                    "c": "for (i = 1 to 10) { print(i) }",
                    "d": "foreach i in 1:10 do print(i) end"
                },
                "respuesta_correcta": "b",
                "explicacion": "La sintaxis correcta es for (variable in secuencia) { expresión }. El uso de llaves es opcional si hay una sola instrucción, pero recomendable. 'i in 1:10' es la forma correcta."
            },
            {
                "id": 10,
                "pregunta": "¿Qué hace la función apply(matrix, 2, mean) en R?",
                "opciones": {
                    "a": "Calcula la media de cada fila de la matriz",
                    "b": "Calcula la media de cada columna de la matriz",
                    "c": "Calcula la media de todos los elementos de la matriz",
                    "d": "Aplica la función mean a un vector"
                },
                "respuesta_correcta": "b",
                "explicacion": "El segundo argumento MARGIN indica la dimensión: 1 = filas, 2 = columnas. apply(matriz, 2, mean) calcula la media por columnas. apply(matriz, 1, mean) sería por filas."
            },
            {
                "id": 11,
                "pregunta": "¿Qué función permite aplicar una función a subconjuntos de un vector definidos por los niveles de un factor (ej. media por grupo)?",
                "opciones": {
                    "a": "apply()",
                    "b": "lapply()",
                    "c": "tapply()",
                    "d": "sapply()"
                },
                "respuesta_correcta": "c",
                "explicacion": "tapply(X, INDEX, FUN) divide el vector X según los niveles del factor INDEX y aplica la función FUN a cada subgrupo. Es ideal para estadísticas descriptivas por grupos (ej. tapply(salario, sexo, mean))."
            },
            {
                "id": 12,
                "pregunta": "¿Por qué es preferible usar operaciones vectorizadas en lugar de bucles 'for' en R?",
                "opciones": {
                    "a": "Porque son más fáciles de escribir",
                    "b": "Porque son mucho más eficientes computacionalmente",
                    "c": "Porque los bucles 'for' no existen en R",
                    "d": "Porque las operaciones vectorizadas permiten usar más tipos de datos"
                },
                "respuesta_correcta": "b",
                "explicacion": "R es un lenguaje vectorizado por naturaleza. Las operaciones vectorizadas (ej. x + y) están implementadas en lenguajes compilados (C/Fortran) y son mucho más rápidas que los bucles en R interpretado. Siempre que sea posible, se debe evitar el uso de bucles."
            }
        ];

        let preguntaActual = 0;
        let respuestas = new Array(preguntas.length).fill(null);
        let cuestionarioFinalizado = false;

        function inicializarCuestionario() {
            const contenedor = document.getElementById('contenedor-preguntas');
            contenedor.innerHTML = '';

            preguntas.forEach((p, index) => {
                const div = document.createElement('div');
                div.className = 'pregunta-container';
                if (index === 0) div.classList.add('activa');
                div.id = 'pregunta-' + index;

                let opcionesHTML = '';
                const letras = ['a', 'b', 'c', 'd'];
                for (let letra of letras) {
                    opcionesHTML += `
                        <div class="opcion" id="opcion-${index}-${letra}" onclick="seleccionarRespuesta(${index}, '${letra}')">
                            <div class="letra-opcion">${letra.toUpperCase()}</div>
                            <div class="texto-opcion">${p.opciones[letra]}</div>
                        </div>
                    `;
                }

                div.innerHTML = `
                    <div class="numero-pregunta">PREGUNTA ${p.id}</div>
                    <div class="texto-pregunta">${p.pregunta}</div>
                    <div class="opciones">
                        ${opcionesHTML}
                    </div>
                    <div class="explicacion" id="explicacion-${index}">
                        <strong>💡 Explicación:</strong> ${p.explicacion}
                    </div>
                `;

                contenedor.appendChild(div);
            });

            actualizarNavegacion();
        }

        function seleccionarRespuesta(index, letra) {
            if (cuestionarioFinalizado) return;

            if (respuestas[index] !== null) return;

            respuestas[index] = letra;
            const pregunta = preguntas[index];

            // Marcar todas las opciones
            const letras = ['a', 'b', 'c', 'd'];
            letras.forEach(l => {
                const opcion = document.getElementById('opcion-' + index + '-' + l);
                if (opcion) {
                    opcion.style.pointerEvents = 'none';
                    if (l === pregunta.respuesta_correcta) {
                        opcion.classList.add('correcta');
                    }
                }
            });

            // Marcar la selección del usuario
            const opcionUsuario = document.getElementById('opcion-' + index + '-' + letra);
            if (opcionUsuario) {
                opcionUsuario.classList.add('seleccionada');
                if (letra !== pregunta.respuesta_correcta) {
                    opcionUsuario.classList.add('incorrecta');
                }
            }

            const explicacion = document.getElementById('explicacion-' + index);
            if (explicacion) {
                explicacion.classList.add('visible');
            }
        }

        function mostrarPregunta(index) {
            document.querySelectorAll('.pregunta-container').forEach(p => p.classList.remove('activa'));
            const preguntaDiv = document.getElementById('pregunta-' + index);
            if (preguntaDiv) {
                preguntaDiv.classList.add('activa');
            }

            document.getElementById('texto-progreso').textContent = 'Pregunta ' + (index + 1) + ' de ' + preguntas.length;
            document.getElementById('barra-progreso').style.width = ((index + 1) / preguntas.length * 100) + '%';

            actualizarNavegacion();
        }

        function actualizarNavegacion() {
            document.getElementById('btn-anterior').disabled = preguntaActual === 0;

            if (preguntaActual === preguntas.length - 1) {
                document.getElementById('btn-siguiente').textContent = '✅ Finalizar';
            } else {
                document.getElementById('btn-siguiente').textContent = 'Siguiente ▶';
            }
        }

        function preguntaSiguiente() {
            if (preguntaActual === preguntas.length - 1) {
                finalizarCuestionario();
                return;
            }

            if (preguntaActual < preguntas.length - 1) {
                preguntaActual++;
                mostrarPregunta(preguntaActual);
            }
        }

        function preguntaAnterior() {
            if (preguntaActual > 0) {
                preguntaActual--;
                mostrarPregunta(preguntaActual);
            }
        }

        function finalizarCuestionario() {
            cuestionarioFinalizado = true;

            let aciertos = 0;
            preguntas.forEach((p, index) => {
                if (respuestas[index] === p.respuesta_correcta) {
                    aciertos++;
                }
            });

            document.getElementById('zona-cuestionario').style.display = 'none';
            document.getElementById('resultado-container').classList.add('visible');
            document.getElementById('puntaje-final').textContent = aciertos + '/' + preguntas.length;

            const porcentaje = (aciertos / preguntas.length) * 100;
            const mensaje = document.getElementById('mensaje-final');

            if (porcentaje >= 90) {
                mensaje.innerHTML = '🌟 <strong>¡Excelente!</strong><br>Dominas perfectamente los conceptos de R. ¡Aprobado con honores!';
            } else if (porcentaje >= 70) {
                mensaje.innerHTML = '👍 <strong>¡Buen trabajo!</strong><br>Tienes una buena comprensión. Revisa las preguntas que fallaste para afianzar.';
            } else if (porcentaje >= 50) {
                mensaje.innerHTML = '📚 <strong>Vas por buen camino.</strong><br>Necesitas repasar el resumen con más atención.';
            } else {
                mensaje.innerHTML = '📖 <strong>Es hora de estudiar más.</strong><br>Revisa el material sobre estructuras de datos, gráficos, AED y programación en R.';
            }
        }

        function reiniciarCuestionario() {
            preguntaActual = 0;
            respuestas = new Array(preguntas.length).fill(null);
            cuestionarioFinalizado = false;

            document.getElementById('zona-cuestionario').style.display = 'block';
            document.getElementById('resultado-container').classList.remove('visible');

            inicializarCuestionario();
            mostrarPregunta(0);
        }

        inicializarCuestionario();
    </script>
</body>
</html>
